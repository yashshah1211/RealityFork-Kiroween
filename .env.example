# Copy to .env.local (git-ignored) and fill in. Never commit the real key.
# Optional GroqCloud key for local development or self-hosting. https://console.groq.com/keys
GROQ_API_KEY=
# Optional: openai/gpt-oss-120b (default) or openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
# Optional server-only judge AI configuration. See docs/judge-ai-access.md.
# SHA-256 hex digest of a private invite. Up to 16 digests, comma-separated.
RF_JUDGE_INVITE_SHA256=
RF_JUDGE_SESSION_SECRET=
RF_JUDGE_ORIGIN=
