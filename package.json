{
  "name": "realityfork",
  "private": true,
  "version": "0.1.0",
  "description": "RealityFork: reproducible, branchable decision-exploration simulations (validation prototype).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "test": "npm run test --workspace @realityfork/core && npm run test --workspace @realityfork/web",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "dev": "npm run dev --workspace @realityfork/web",
    "build": "npm run build --workspace @realityfork/web",
    "start": "npm run start --workspace @realityfork/web",
    "e2e": "npm run e2e --workspace @realityfork/web",
    "sim": "tsx packages/cli/src/sim.ts",
    "benchmark": "tsx packages/cli/src/benchmark.ts",
    "rf": "tsx packages/cli/src/rf.ts",
    "generate:synthetic": "tsx packages/cli/src/generate-synthetic.ts",
    "demo:daypart": "tsx packages/cli/src/daypart-demo.ts",
    "plan:eval": "tsx packages/web/server/eval.ts",
    "r19:live": "tsx packages/web/server/r19-live.ts",
    "r19:reread": "tsx packages/web/server/r19-live-reread.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
