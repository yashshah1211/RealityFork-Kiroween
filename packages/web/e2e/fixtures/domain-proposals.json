          }
        ]
      },
      {
        "name": "No solar",
        "description": "Keep buying all electricity from the grid.",
        "settings": []
      }
    ],
    "variables": [
      {
        "key": "battery",
        "label": "Battery included",
        "kind": "boolean",
        "unit": "",
        "options": [],
        "why": "Changes cost and how much is used at home."
      },
      {
        "key": "installCost",
        "label": "Installation cost",
        "kind": "number",
        "unit": "one-off",
        "options": [],
        "why": "Needs a quote."
      },
      {
        "key": "yearlyGeneration",
        "label": "Electricity generated",
        "kind": "number",
        "unit": "kWh per year",
        "options": [],
        "why": "Depends on roof and weather."
      },
      {
        "key": "pricePerKwh",
        "label": "Electricity price",
        "kind": "number",
        "unit": "per kWh",
        "options": [],
        "why": "Sets the value of each unit generated."
      }
    ],
    "questions": [
      "Which direction does the roof face?",
      "What would an installer charge?"
    ],
    "formulas": [
      {
        "label": "Value per year",
        "expression": "yearlyGeneration * pricePerKwh",
        "unit": "per year",
        "condition": "",
        "explanation": "Assumes every unit generated replaces a bought unit."
      },
      {
        "label": "Years to pay back",
        "expression": "installCost / (yearlyGeneration * pricePerKwh)",
        "unit": "years",
        "condition": "yearlyGeneration * pricePerKwh > 0",
        "explanation": "Only meaningful when there is a yearly value."
      }
    ],
    "possibilities": [
      {
        "branch": "Panels and battery",
        "text": "Some backup power during outages",
