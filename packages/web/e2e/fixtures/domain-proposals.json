{
  "What if I moved to another country?": {
    "interpretation": "You are thinking about relocating abroad. I assumed you would compare moving with a job, moving without one, and staying.",
    "contextQuestions": [],
    "branches": [
      {
        "name": "Move with a job offer",
        "description": "Relocate after securing work in the new country.",
        "settings": [
          {
            "variable": "haveJobOffer",
            "value": "yes"
          }
        ]
      },
      {
        "name": "Move and look for work",
        "description": "Relocate first and search for a job there.",
        "settings": [
          {
            "variable": "haveJobOffer",
            "value": "no"
          }
        ]
      },
      {
        "name": "Stay where I am",
        "description": "Do not relocate for now.",
        "settings": []
      }
    ],
    "variables": [
      {
        "key": "haveJobOffer",
        "label": "Job offer before moving",
        "kind": "boolean",
        "unit": "",
        "options": [],
        "why": "Income security changes the risk."
      },
      {
        "key": "monthlyIncome",
        "label": "Take-home pay",
        "kind": "number",
        "unit": "per month",
        "options": [],
        "why": "Pay may differ a lot between countries."
      },
      {
        "key": "monthlyCosts",
        "label": "Living costs",
        "kind": "number",
        "unit": "per month",
        "options": [],
        "why": "Rent and everyday costs differ by city."
      },
      {
        "key": "movingCost",
        "label": "One-off moving and visa costs",
        "kind": "number",
        "unit": "one-off",
        "options": [],
        "why": "Paid before any benefit arrives."
      }
    ],
    "questions": [
      "Which country and city?",
      "Would your visa allow you to work?",
      "What would rent cost there?"
    ],
    "formulas": [
      {
        "label": "Saved per month",
        "expression": "monthlyIncome - monthlyCosts",
        "unit": "per month",
        "condition": "",
        "explanation": "Pay minus living costs."
      },
      {
        "label": "Saved in the first year",
        "expression": "(monthlyIncome - monthlyCosts) * 12 - movingCost",
        "unit": "",
        "condition": "",
        "explanation": "Twelve months of savings minus the one-off cost."
      }
    ],
    "possibilities": [
      {
        "branch": "Move and look for work",
        "text": "A period without income while searching",
        "tone": "challenge",
        "about": []
      },
      {
        "branch": "all",
        "text": "Missing family and friends",
        "tone": "challenge",
        "about": []
      },
      {
        "branch": "Move with a job offer",
        "text": "A fresh start with income from day one",
        "tone": "upside",
        "about": []
      },
      {
        "branch": "Stay where I am",
        "text": "Familiar routines and people stay close",
        "tone": "upside",
        "about": []
      }
    ],
    "missingEvidence": [
      "Visa and work-permit rules",
      "Rents in the target city"
    ],
    "limitations": [
      "Exchange rates and personal circumstances are not modelled."
    ]
