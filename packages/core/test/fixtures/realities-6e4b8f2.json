          "key": "monthlySavings",
          "label": "Saved each month",
          "expression": "netIncome - rent - livingCosts",
          "unit": "£ per month",
          "condition": "",
          "note": "",
          "reviewed": false
        },
        {
          "key": "yearlySavings",
          "label": "Saved in the first year",
          "expression": "monthlySavings * 12 - movingCost",
          "unit": "£",
          "condition": "",
          "note": "",
          "reviewed": false
        },
        {
          "key": "savingsRate",
          "label": "Share of pay saved",
          "expression": "round(monthlySavings / netIncome * 100, 1)",
          "unit": "%",
          "condition": "netIncome > 0",
          "note": "",
          "reviewed": false
        },
        {
          "key": "commuteHours",
          "label": "Commuting per week",
          "expression": "if(remoteWork, 0, commuteMinutes * 2 * 5 / 60)",
          "unit": "hours",
          "condition": "",
          "note": "",
          "reviewed": false
        }
      ],
